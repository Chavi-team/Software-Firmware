{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "firmware-chavi",
  "version": "1.0.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build"
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://raw.githubusercontent.com/GuilhermeMendina/firmware-chavi/main/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxRDQyNTQ2NTNGNUVDMzQKUldRMDdQVlRSaVhVMFpYSm5jY0VPak5waDN0M3UrZG5PLzNic29SWG9iU2hDUTRTSjlMUDlVSnQK"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "firmware-chavi",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "bin/arduino-cli"
    ],
    "resources": [
      "resources/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}